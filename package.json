{
    "name": "@monkin/di",
    "version": "0.3.0",
    "description": "Small type-safe dependency injection lib",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/di.d.ts",
    "exports": {
        ".": {
            "types": "./dist/di.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.umd.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check src",
        "format": "biome format --write src",
        "format:check": "biome format src",
        "prepublishOnly": "npm run lint && npm run test && npm run build"
    },
    "keywords": [
        "dependency-injection",
        "di",
        "typescript",
        "type-safe",
        "container",
        "ioc",
        "lightweight"
    ],
    "author": {
        "name": "Andrei Monkin",
        "email": "monkin.andrey@gmail.com",
        "url": "https://github.com/monkin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/monkin/di.git"
    },
    "bugs": {
        "url": "https://github.com/monkin/di/issues"
    },
    "homepage": "https://github.com/monkin/di#readme",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@types/node": "^26.4.1",
        "@typescript/typescript6": "^6.0.2",
        "esbuild": "^0.28.2",
        "terser": "^5.51.2",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^5.1.0",
        "vitest": "^5.0.0"
    }
}
